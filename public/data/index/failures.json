unding.json"},{"id":"failure-22","title":"Frontend secret exposure","symptom":"브라우저 번들에 secret/service key 포함","root_cause":"publishable과 secret key 혼동","last_verified":"2026-09-21","shard":"data/failures/security-permission.json"},{"id":"failure-23","title":"Client role trust","symptom":"브라우저의 admin 플래그만 믿음","root_cause":"서버 권한 검증 없음","last_verified":"2026-09-21","shard":"data/failures/security-permission.json"},{"id":"failure-24","title":"Retry without idempotency","symptom":"재시도 때 결제/생성이 중복","root_cause":"쓰기 작업 idempotency 없음","last_verified":"2026-09-21","shard":"data/failures/tools-agents.json"},{"id":"failure-25","title":"Agent where workflow is enough","symptom":"단순 순차 업무에 자유형 agent 사용","root_cause":"제어 가능한 workflow를 과도하게 agent화","last_verified":"2026-09-21","shard":"data/failures/tools-agents.json"},{"id":"failure-26","title":"Multi-agent overuse","symptom":"비용/지연은 늘고 품질은 그대로","root_cause":"역할 분할이 실제 병렬성/전문성 없이 형식적","last_verified":"2026-09-21","shard":"data/failures/tools-agents.json"},{"id":"failure-27","title":"Missing tool-result compression","symptom":"도구 결과가 그대로 context를 잠식","root_cause":"필요 필드 필터링 없음","last_verified":"2026-09-21","shard":"data/failures/tools-agents.json"},{"id":"failure-28","title":"Eval contamination","symptom":"평가 데이터가 프롬프트/튜닝에 노출","root_cause":"train/dev/test 분리 실패","last_verified":"2026-09-21","shard":"data/failures/evaluation-reliability.json"},{"id":"failure-29","title":"Benchmark mismatch","symptom":"실제 업무와 무관한 벤치마크만 최적화","root_cause":"task-specific eval 부재","last_verified":"2026-09-21","shard":"data/failures/evaluation-reliability.json"},{"id":"failure-30","title":"No observability","symptom":"실패가 나도 어느 prompt/tool 단계인지 모름","root_cause":"trace/version/cost 로그 없음","last_verified":"2026-09-21","shard":"data/failures/evaluation-reliability.json"}]